    <rule id="_ROOT_" scope="public">
    <one-of>
        <item>
          <ruleref uri="#vocab"/>
        </item>
      </one-of>
    </rule>

    <rule id="vocab" scope="public">
     <one-of>


        <item>
             <tag>SWI_meaning="go_back";</tag>
             <one-of>
                <item><item repeat="0-1">no </item><item repeat="0-1">it's </item>not a laserjet</item>
                <item><item repeat="0-1">no </item><item repeat="0-1">it's </item>not a laser printer</item>
                <item><item repeat="0-1">no </item><item repeat="0-1">i </item>don't have a laserjet</item>
                <item><item repeat="0-1">no </item>it's something else</item>
                <item><item repeat="0-1">no </item>go back</item>
             </one-of>
                    <tag>dm_confirm_string="go_back"; dm_confirmation_mode="IF_NECESSARY"; </tag>
            </item>
            <item>
             <tag>SWI_meaning="dont_know";dm_confirm_string="dont_know"; dm_confirmation_mode="IF_NECESSARY";</tag>
             <one-of>
                <item><item repeat="0-1">i</item> don't know<item repeat="0-1"> it</item></item>
                <item><item repeat="0-1">i</item> don't have<item repeat="0-1"> it</item></item>
                <item><item repeat="0-1">i</item> don't know the model<item repeat="0-1"> number</item></item>
             </one-of>
            </item>

